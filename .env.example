# ============ LLM (pick ONE primary provider) ============
# gemini | groq | openrouter | ollama | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=            # free key: https://aistudio.google.com/apikey
# LLM_MODEL=               # optional; defaults: gemini-flash-latest / llama-3.3-70b-versatile /
#                          #   openrouter/free / qwen2.5:7b / claude-sonnet-5-5
#                          # Free-tier model ids change: if you get "model not found", set this.

# Optional automatic fallback if the primary hits a rate limit or fails
# LLM_FALLBACK_PROVIDER=groq
# GROQ_API_KEY=            # free key: https://console.groq.com/keys
# OPENROUTER_API_KEY=
# LLM_FALLBACK_MODEL=

# Local, unlimited, private (install Ollama, `ollama pull qwen2.5:7b`):
# LLM_PROVIDER=ollama

# --- Retrieval ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=8
MIN_SIMILARITY=0.25

# --- Email (MCP server). Leave SMTP_HOST empty to run in dry-run mode:
#     emails are written as .eml files to ./outbox instead of being sent. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
EMAIL_DRY_RUN=false
