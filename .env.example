# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=gemini...

# --- Retrieval ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=8
MIN_SIMILARITY=0.25

# --- Email (MCP server). Leave SMTP_HOST empty to run in dry-run mode:
#     emails are written as .eml files to ./outbox instead of being sent. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
EMAIL_DRY_RUN=false
